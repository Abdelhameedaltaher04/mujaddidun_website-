# ==================================================================
# Al-Mujaddidun API — environment template
# ==================================================================
# Copy to `.env` and run `php artisan key:generate`.
#
# The values below are LOCAL DEVELOPMENT defaults, so a fresh copy of
# this file gives a working dev environment. Every key that must change
# for production is marked with a `# production:` note inline.
#
# ------------------------------------------------------------------
# PRODUCTION CHECKLIST — override all of these before deploying
# ------------------------------------------------------------------
#   APP_ENV=production
#   APP_DEBUG=false               <- leaving this true leaks stack traces,
#                                    file paths and env values to clients
#   LOG_LEVEL=error
#   APP_KEY=                      <- generate a fresh key; never reuse dev's
#   APP_URL=                      <- real HTTPS API origin. Email verification
#                                    links are signed against this value
#   FRONTEND_URL=                 <- real HTTPS SPA origin. Password-reset,
#                                    verification and OAuth redirects use it
#   FRONTEND_LOGO_URL=            <- absolute HTTPS URL of the email logo
#   CORS_ALLOWED_ORIGINS=         <- the production SPA origin (comma-separated
#                                    for more than one). Must NOT stay localhost
#   SESSION_SECURE_COOKIE=true    <- required under HTTPS
#   DB_*                          <- a real MySQL/PostgreSQL server. The local
#                                    setup uses SQLite, which will not survive
#                                    concurrent writes
#   MAIL_*                        <- a transactional provider with SPF/DKIM/
#                                    DMARC. Gmail SMTP is rate-limited (~500/day)
#                                    and will throttle or flag bulk sending
#   GOOGLE_REDIRECT_URI=          <- the production callback; it must also be
#                                    registered in the Google Cloud Console
#                                    (see the Google Sign-In block below)
#   QUEUE_CONNECTION              <- if not `sync`, run the queue table
#                                    migrations and a supervised worker
#
# The real production domains are not decided yet, so this file
# deliberately contains no production hostnames.
#
# Never commit real secrets. `.env` is gitignored; this template is not.
# ==================================================================

APP_NAME="Al-Mujaddidun API"
APP_ENV=local                       # production: production
APP_KEY=
APP_DEBUG=true                      # production: false
APP_URL=http://localhost:8000       # production: real HTTPS API origin
FRONTEND_URL=http://localhost:5173  # production: real HTTPS SPA origin
FRONTEND_LOGO_URL=http://localhost:5173/favicon.png
AUTH_VERIFICATION_EXPIRE=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                     # production: error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=al_mujaddidun
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false         # production: true (HTTPS only)

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SANCTUM_EXPIRATION=null
SANCTUM_TOKEN_PREFIX=
# Comma-separated list of allowed browser origins for /api/*.
# production: the real SPA origin(s); never leave localhost in place.
CORS_ALLOWED_ORIGINS=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------
# Mail. `log` writes messages to storage/logs/laravel.log instead of
# sending them — handy for local work. Switch MAIL_MAILER to `smtp` and
# fill in the rest to deliver for real.
#
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME is the
# full address and MAIL_PASSWORD is a 16-character Google App Password
# (2-Step Verification must be on) — never an account password.
# Leave real credentials out of this file; it is committed.
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# ------------------------------------------------------------------
# Google Sign-In (OAuth 2.0)
# Create a "Web application" OAuth client in the Google Cloud Console.
# Leave these blank to disable Google Sign-In; never commit real values.
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
#
# Production needs a SEPARATE redirect URI on the real domain. Add it under
# "Authorized redirect URIs" on the same OAuth client (or a production-only
# client) in the Google Cloud Console, then set GOOGLE_REDIRECT_URI to it —
# Google requires an exact match on scheme, host, port and path. The
# production SPA origin also has to be added to "Authorized JavaScript
# origins". Remember to move the consent screen from Testing to Published:
# Testing caps you at 100 users and expires refresh tokens after 7 days.

# ------------------------------------------------------------------
# Anthropic — public support assistant (chatbot)
# BACKEND ONLY. This key must never be exposed to the browser: do not
# add a VITE_ counterpart, and never return it from an API response.
# Leave ANTHROPIC_API_KEY blank to disable the chatbot; the endpoint
# then returns a clean 503 instead of failing.
#
# Local development without a key: when APP_ENV is `local` or
# `development` AND no key is set, the chat endpoint is served by a
# built-in mock provider with canned Mujaddidun answers, so the UI can be
# built without spending anything. This never applies in production or
# testing — there, a missing key returns 503 `ai_not_configured`.
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
