# ============================================================
# Backend environment variables (Express API server)
# ============================================================
# NOTE: In this environment, PORT and DATABASE_URL are injected
# automatically by the platform (managed workflow + managed
# PostgreSQL). Secrets (e.g. SESSION_SECRET) are managed through
# the platform's secrets manager — never commit real values.

# --- Injected automatically (documented for reference only) ---
# PORT=                # assigned by the managed workflow
# DATABASE_URL=        # managed PostgreSQL connection string
# SESSION_SECRET=      # managed secret

# --- Application configuration ---
NODE_ENV=development
LOG_LEVEL=info
