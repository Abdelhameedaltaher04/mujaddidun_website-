# ============================================================
# Frontend environment variables (Vite)
# ============================================================
# Only variables prefixed with VITE_ are exposed to the client.
# NEVER put secrets here — everything in this file ships to the browser.
#
# NOTE: PORT and BASE_PATH are injected automatically by the managed
# workflow — do not set them manually.

# Application display name
VITE_APP_NAME="Al-Mujaddidun Charity and Development Association"

# Default language: "ar" | "en"
VITE_DEFAULT_LOCALE=ar

# Laravel API base URL, including the /api/v1 version prefix.
#
# Local:      point at the Laravel dev server (below).
# Production: set the real HTTPS API origin at build time via a CI/host
#             environment variable. Vite inlines VITE_* values into the bundle
#             when you run `npm run build`, so this must be set BEFORE the
#             build, not at runtime. If the API is reverse-proxied under the
#             same domain as the SPA, the relative "/api/v1" works instead.
# The production domain is not known yet, so no value is committed here.
VITE_API_URL=http://127.0.0.1:8000/api/v1

# NOTE: do not add a BASE_URL entry to this file.
# `import.meta.env.BASE_URL` is Vite's BUILT-IN public base path — it comes from
# `base:` in vite.config.ts (fed by the BASE_PATH env var), and the app uses it
# as the SPA router base (App.tsx) and to build the login redirect (services/
# api.ts). Vite never exposes a plain BASE_URL from this file, so such a line is
# dead config that only invites someone to "wire it up" and break every route.
